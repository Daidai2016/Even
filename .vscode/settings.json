{
    // =====================================
    // Codex Design Workspace Settings
    // VS Code 工作环境配置 V2.0
    // =====================================


    // 默认编码
    // 普通文件使用 UTF-8

    "files.encoding": "utf-8",

    "files.autoGuessEncoding": true,


    // PowerShell 特殊处理
    // Windows PowerShell 5.1 推荐 BOM

    "[powershell]": {
        "files.encoding": "utf8bom",
        "editor.formatOnSave": false
    },


    // 编辑器基础

    "editor.tabSize": 4,

    "editor.insertSpaces": true,

    "editor.wordWrap": "on",

    "editor.minimap.enabled": false,


    // 不全局自动格式化
    // 避免影响 Adobe JSX

    "editor.formatOnSave": false,


    // JavaScript / Adobe JSX

    "javascript.validate.enable": true,


    "files.associations": {

        "*.jsx": "javascript",

        "*.jsxinc": "javascript",

        "*.jsxbin": "javascript"

    },


    // Markdown

    "[markdown]": {

        "editor.wordWrap": "on",

        "editor.tabSize": 4,

        "editor.insertSpaces": true

    },


    "markdown.preview.breaks": true,

    "markdown.preview.linkify": true,


    // JSON

    "[json]": {

        "editor.tabSize": 4,

        "editor.insertSpaces": true

    },


    // Git

    "git.autofetch": true,

    "git.confirmSync": false,


    // 搜索排除

    "search.exclude": {

        "**/.git": true,

        "**/node_modules": true

    },


    // 文件显示

    "files.exclude": {

        "**/.git": true,

        "**/node_modules": true

    },


    // Windows PowerShell
    // 仅影响本工作区新终端，不修改系统执行策略。

    "terminal.integrated.profiles.windows": {
        "PowerShell (Codex Design)": {
            "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass"
            ]
        }
    },

    "terminal.integrated.defaultProfile.windows": "PowerShell (Codex Design)",


    // AI/Codex

    "chat.editor.wordWrap": "on"

}
